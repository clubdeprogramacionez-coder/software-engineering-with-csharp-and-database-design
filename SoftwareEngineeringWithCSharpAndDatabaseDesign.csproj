<Project Sdk="Microsoft.NET.Sdk">
  <!-- Configuración General del Proyecto -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Información de Ensamblado -->
  <PropertyGroup>
    <AssemblyName>SoftwareEngineeringWithCSharpAndDatabaseDesign</AssemblyName>
    <RootNamespace>SoftwareEngineeringWithCSharpAndDatabaseDesign</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Club de Programación</Authors>
    <Description>Proyecto de ingeniería de software con arquitectura limpia y diseño de base de datos</Description>
    <RepositoryUrl>https://github.com/ClubDeProgramacion/software-engineering-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Configuración Debug -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- Configuración Release -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Dependencias de NuGet (se agregarán después) -->
  <ItemGroup>
    <!-- Ejemplos de paquetes que se pueden necesitar:
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    -->
  </ItemGroup>
</Project>
